logs/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/

# CSV data
*.csv

# Word docs
*.docx
~$*.docx

# Schwab OAuth tokens
token_accounts.json
token_market.json
*.token.json
.schwab/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# CLI bundle artifacts — immutable snapshots, regenerable, do not commit
bundles/

# FMP local cache — regenerable, do not commit
data/fmp_cache/

# Local PortfolioStore SQLite ledger — regenerable via pm store sync-from-sheets
data/portfolio_store.db
data/portfolio_store.db-*
data/portfolio_store_backups/


# ETF look-through holdings cache (yfinance) — regenerable, do not commit
data/etf_holdings_cache/

Books/

# Phase 4 Exports
exports/

# Podcast bundles — transient convenience artifacts, not committed
data/podcast_bundles/

# Archive-before-overwrite backups — regenerable, produced anywhere a pipeline
# script overwrites a file in place (root docs, core/, tasks/, vault/theses/)
*.bak.*
# Thesis plain .bak (unsanctioned; was leaking into git)
*.bak

# Valuation drift Option A baselines (regenerable)
data/valuation_drift_baselines.json

# Excel files
*.xlsx

# Build artifacts
*.egg-info/

# One-off audit artifacts
audit_results.txt
bundle_audit.md

# Runtime-generated, contains real account dollar figures — not committed
data/account_balances.json

# Runtime-generated Schwab token alert (local mirror of the GCS blob)
schwab_alert.json

# Podcast transcripts — large data files, not committed
data/podcast_transcripts/

# Podcast summaries — regenerated per run, same treatment as transcripts/bundles
data/podcast_summaries/

# Spotify Studio digest corpus mirror + sha256 ledger — regenerated per run
data/spotify_digests/

# Cached moment extraction (tasks/extract_moments.py) — regenerated per transcript
data/moments/

# Agent output reports — regenerated per run, not committed (agent_outputs/{agent}/*.md)
agent_outputs/

# Google Drive backup upload staging — transient, created by `pm backup`
.tmp.driveupload/

# Windows Explorer folder-customization files — pure OS noise, not project content
desktop.ini

# Claude Code local permission/session settings — machine-local, not project content
.claude/settings.local.json

# Processed-video ledger — regenerated per run, same treatment as podcast_summaries/
data/processed_videos.json

# Generated / local-only
data/schwab_price_cache/
morningstar.pdf
vault/theses/*.bak
